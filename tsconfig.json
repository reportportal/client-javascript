{
  "compilerOptions": {
    "sourceMap": true,
    "esModuleInterop": true,
    "allowJs": false,
    "noImplicitAny": true,
    "moduleResolution": "node",
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "downlevelIteration": true,
    "declaration": true,
    "lib": ["ES2020"],
    "module": "commonjs",
    "target": "ES2020",
    "rootDir": "src",
    "outDir": "./build",
    "baseUrl": ".",
    "typeRoots": ["node_modules/@types", "src/types"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "__tests__"]
}
